# Test images for the VS Code integration test. Build with --target clean or --target sim.
FROM docker.io/library/node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb xauth python3 python3-venv python3-pip ca-certificates tar xz-utils \
      libgtk-3-0 libnss3 libasound2 libgbm1 libxss1 libxkbfile1 libsecret-1-0 \
      libatk-bridge2.0-0 libdrm2 libxtst6 libxshmfence1 libx11-xcb1 dbus \
    && rm -rf /var/lib/apt/lists/*

# Image vsc-clean: no simdref-lsp.
FROM base AS clean
USER node
WORKDIR /ext

# Image vsc-stub: a fake simdref-lsp without inlayHintProvider (like simdref 0.0.7).
FROM base AS stub
COPY stub-lsp.js /usr/local/bin/simdref-lsp
RUN chmod +x /usr/local/bin/simdref-lsp
USER node
WORKDIR /ext

# Image vsc-sim: simdref-lsp from PyPI. When the build context "simdref" holds a source tree, install from it instead.
FROM base AS sim
COPY --from=simdref . /tmp/simdref-src/
RUN python3 -m venv /opt/sr \
    && if [ -f /tmp/simdref-src/pyproject.toml ]; then \
         /opt/sr/bin/pip install --no-cache-dir /tmp/simdref-src; \
       else \
         /opt/sr/bin/pip install --no-cache-dir simdref; \
       fi \
    && rm -rf /tmp/simdref-src \
    && ln -s /opt/sr/bin/simdref-lsp /usr/local/bin/simdref-lsp
USER node
WORKDIR /ext
